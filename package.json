{
  "name": "vineyard",
  "displayName": "Vineyard",
  "description": "Tend your AI agents across machines: see every Claude Code session on every box, what it is doing, and when it needs you.",
  "version": "0.3.20",
  "publisher": "peter-dolkens",
  "author": "peter-dolkens",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/peter-dolkens/vineyard"
  },
  "bugs": {
    "url": "https://github.com/peter-dolkens/vineyard/issues"
  },
  "homepage": "https://github.com/peter-dolkens/vineyard#readme",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "agents",
    "ssh",
    "fleet",
    "sessions"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vineyard",
          "title": "Vineyard",
          "icon": "media/vineyard.svg"
        }
      ]
    },
    "views": {
      "vineyard": [
        {
          "id": "vineyard.fleet",
          "name": "Agents",
          "icon": "media/vineyard.svg",
          "contextualTitle": "Vineyard"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vineyard.fleet",
        "contents": "Vineyard runs a tiny daemon on each machine; they talk to each other only while a VS Code window is watching.\n\nThis machine is not set up yet.\n\n[Set Up This Machine](command:vineyard.setupLocal)\n\nStart a new fleet here: writes ~/.vineyard/config.json, generates the fleet certificate and installs a login service.\n\n[Join Fleet with Invite Code](command:vineyard.joinWithCode)\n\nAlready have a fleet? Create an invite code from a machine that is in it (Vineyard: Create Invite Code) and paste it here. No SSH needed.\n\n[Setup guide](https://github.com/peter-dolkens/vineyard/blob/main/docs/SETUP.md) with screenshots and troubleshooting.",
        "when": "vineyard.daemonState == 'no-config'"
      },
      {
        "view": "vineyard.fleet",
        "contents": "Cannot reach the local Vineyard daemon.\n[Restart Daemon](command:vineyard.restartDaemon)\n[Reconnect](command:vineyard.reconnect)\n[Show Output](command:vineyard.showOutput)",
        "when": "vineyard.daemonState == 'disconnected'"
      },
      {
        "view": "vineyard.fleet",
        "contents": "Connecting to the local daemon…",
        "when": "vineyard.daemonState == 'connecting'"
      }
    ],
    "commands": [
      {
        "command": "vineyard.refresh",
        "title": "Refresh",
        "category": "Vineyard",
        "icon": "$(refresh)"
      },
      {
        "command": "vineyard.setupLocal",
        "title": "Set Up This Machine",
        "category": "Vineyard",
        "icon": "$(rocket)"
      },
      {
        "command": "vineyard.createInvite",
        "title": "Create Invite Code (join without SSH)",
        "category": "Vineyard",
        "icon": "$(link)"
      },
      {
        "command": "vineyard.joinWithCode",
        "title": "Join Fleet with Invite Code",
        "category": "Vineyard",
        "icon": "$(plug)"
      },
      {
        "command": "vineyard.addMachine",
        "title": "Add Machine (install daemon over SSH)",
        "category": "Vineyard",
        "icon": "$(add)"
      },
      {
        "command": "vineyard.updateMachine",
        "title": "Update Daemon",
        "category": "Vineyard",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vineyard.removeMachine",
        "title": "Remove Machine",
        "category": "Vineyard",
        "icon": "$(trash)"
      },
      {
        "command": "vineyard.restartDaemon",
        "title": "Restart Daemon",
        "category": "Vineyard",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vineyard.showDaemonLog",
        "title": "Show Daemon Log",
        "category": "Vineyard",
        "icon": "$(output)"
      },
      {
        "command": "vineyard.showOutput",
        "title": "Show Output",
        "category": "Vineyard"
      },
      {
        "command": "vineyard.reconnect",
        "title": "Reconnect to Local Daemon",
        "category": "Vineyard"
      },
      {
        "command": "vineyard.openWorkspace",
        "title": "Open Workspace in VS Code",
        "category": "Vineyard",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vineyard.openTerminal",
        "title": "Open Terminal Here",
        "category": "Vineyard",
        "icon": "$(terminal)"
      },
      {
        "command": "vineyard.showTranscript",
        "title": "Open Chat",
        "category": "Vineyard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vineyard.resumeSession",
        "title": "Resume Session in Terminal",
        "category": "Vineyard",
        "icon": "$(debug-continue)"
      },
      {
        "command": "vineyard.copySessionId",
        "title": "Copy Session ID",
        "category": "Vineyard"
      },
      {
        "command": "vineyard.copyPath",
        "title": "Copy Path",
        "category": "Vineyard"
      },
      {
        "command": "vineyard.toggleHistorical",
        "title": "Toggle Historical Workspaces",
        "category": "Vineyard",
        "icon": "$(history)"
      },
      {
        "command": "vineyard.toggleExited",
        "title": "Toggle Exited Agents",
        "category": "Vineyard",
        "icon": "$(eye-closed)"
      },
      {
        "command": "vineyard.focus",
        "title": "Focus Vineyard",
        "category": "Vineyard"
      },
      {
        "command": "vineyard.newAgent",
        "title": "New Agent Here…",
        "category": "Vineyard",
        "icon": "$(add)"
      },
      {
        "command": "vineyard.takeOver",
        "title": "Take Over Session",
        "category": "Vineyard",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "vineyard.resumeManaged",
        "title": "Resume Under Vineyard Control…",
        "category": "Vineyard",
        "icon": "$(debug-continue)"
      },
      {
        "command": "vineyard.stopAgent",
        "title": "Stop / Terminate Session",
        "category": "Vineyard",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vineyard.showRawTranscript",
        "title": "Show Raw Transcript (Markdown)",
        "category": "Vineyard"
      },
      {
        "command": "vineyard.updateAllDaemons",
        "title": "Update All Daemons to Bundled Version",
        "category": "Vineyard",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vineyard.checkForUpdates",
        "title": "Check for Extension Updates",
        "category": "Vineyard"
      },
      {
        "command": "vineyard.resumeFromHistory",
        "title": "Resume a Past Session…",
        "category": "Vineyard",
        "icon": "$(history)"
      },
      {
        "command": "vineyard.login",
        "title": "Sign In to Claude on Machine…",
        "category": "Vineyard",
        "icon": "$(key)"
      },
      {
        "command": "vineyard.renameSession",
        "title": "Rename Session…",
        "category": "Vineyard",
        "icon": "$(edit)"
      },
      {
        "command": "vineyard.openSettings",
        "title": "Settings",
        "category": "Vineyard",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vineyard.wakeMachine",
        "title": "Wake Machine",
        "category": "Vineyard",
        "icon": "$(bell)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vineyard.refresh",
          "when": "view == vineyard.fleet",
          "group": "navigation@1"
        },
        {
          "command": "vineyard.addMachine",
          "when": "view == vineyard.fleet",
          "group": "navigation@3"
        },
        {
          "command": "vineyard.resumeFromHistory",
          "when": "view == vineyard.fleet",
          "group": "navigation@2"
        },
        {
          "command": "vineyard.createInvite",
          "when": "view == vineyard.fleet",
          "group": "navigation@4"
        },
        {
          "command": "vineyard.toggleHistorical",
          "when": "view == vineyard.fleet",
          "group": "1_view@1"
        },
        {
          "command": "vineyard.toggleExited",
          "when": "view == vineyard.fleet",
          "group": "1_view@2"
        },
        {
          "command": "vineyard.setupLocal",
          "when": "view == vineyard.fleet",
          "group": "2_setup@1"
        },
        {
          "command": "vineyard.showOutput",
          "when": "view == vineyard.fleet",
          "group": "2_setup@2"
        },
        {
          "command": "vineyard.joinWithCode",
          "when": "view == vineyard.fleet",
          "group": "2_setup@3"
        },
        {
          "command": "vineyard.updateAllDaemons",
          "when": "view == vineyard.fleet",
          "group": "2_setup@4"
        },
        {
          "command": "vineyard.checkForUpdates",
          "when": "view == vineyard.fleet",
          "group": "2_setup@5"
        },
        {
          "command": "vineyard.openSettings",
          "when": "view == vineyard.fleet",
          "group": "1_view@3"
        }
      ],
      "view/item/context": [
        {
          "command": "vineyard.openTerminal",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/",
          "group": "inline@1"
        },
        {
          "command": "vineyard.updateMachine",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/",
          "group": "1_manage@1"
        },
        {
          "command": "vineyard.restartDaemon",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/",
          "group": "1_manage@2"
        },
        {
          "command": "vineyard.showDaemonLog",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/",
          "group": "1_manage@3"
        },
        {
          "command": "vineyard.removeMachine",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/ && viewItem != machine-local",
          "group": "2_remove@1"
        },
        {
          "command": "vineyard.openWorkspace",
          "when": "view == vineyard.fleet && viewItem =~ /^workspace/",
          "group": "inline@1"
        },
        {
          "command": "vineyard.openTerminal",
          "when": "view == vineyard.fleet && viewItem =~ /^workspace/",
          "group": "inline@2"
        },
        {
          "command": "vineyard.copyPath",
          "when": "view == vineyard.fleet && viewItem =~ /^workspace/",
          "group": "1_copy@1"
        },
        {
          "command": "vineyard.showTranscript",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "inline@1"
        },
        {
          "command": "vineyard.openTerminal",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "inline@2"
        },
        {
          "command": "vineyard.resumeSession",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "1_act@1"
        },
        {
          "command": "vineyard.openWorkspace",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "1_act@2"
        },
        {
          "command": "vineyard.copySessionId",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "2_copy@1"
        },
        {
          "command": "vineyard.copyPath",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "2_copy@2"
        },
        {
          "command": "vineyard.newAgent",
          "when": "view == vineyard.fleet && viewItem =~ /^workspace/",
          "group": "inline@0"
        },
        {
          "command": "vineyard.newAgent",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/ && viewItem != machine-offline",
          "group": "0_agent@1"
        },
        {
          "command": "vineyard.takeOver",
          "when": "view == vineyard.fleet && viewItem =~ /^agent-(?!exited)(?!.*managed)/",
          "group": "1_act@0"
        },
        {
          "command": "vineyard.resumeManaged",
          "when": "view == vineyard.fleet && viewItem =~ /^agent-(?!.*managed)/",
          "group": "1_act@1"
        },
        {
          "command": "vineyard.stopAgent",
          "when": "view == vineyard.fleet && viewItem =~ /^agent-(?!exited)/",
          "group": "inline@3"
        },
        {
          "command": "vineyard.showRawTranscript",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "2_copy@0"
        },
        {
          "command": "vineyard.showTranscript",
          "when": "view == vineyard.fleet && viewItem =~ /^subagent/",
          "group": "inline@1"
        },
        {
          "command": "vineyard.showRawTranscript",
          "when": "view == vineyard.fleet && viewItem =~ /^subagent/",
          "group": "2_copy@0"
        },
        {
          "command": "vineyard.copyPath",
          "when": "view == vineyard.fleet && viewItem =~ /^subagent/",
          "group": "2_copy@2"
        },
        {
          "command": "vineyard.resumeFromHistory",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/ && viewItem != machine-offline",
          "group": "0_agent@2"
        },
        {
          "command": "vineyard.resumeFromHistory",
          "when": "view == vineyard.fleet && viewItem =~ /^workspace/",
          "group": "0_agent@2"
        },
        {
          "command": "vineyard.login",
          "when": "view == vineyard.fleet && viewItem =~ /^machine/ && viewItem != machine-offline",
          "group": "1_manage@0"
        },
        {
          "command": "vineyard.renameSession",
          "when": "view == vineyard.fleet && viewItem =~ /^agent/",
          "group": "1_act@3"
        },
        {
          "command": "vineyard.wakeMachine",
          "when": "view == vineyard.fleet && viewItem == machine-offline",
          "group": "inline@0"
        },
        {
          "command": "vineyard.wakeMachine",
          "when": "view == vineyard.fleet && viewItem == machine-offline",
          "group": "0_agent@0"
        }
      ],
      "commandPalette": [
        {
          "command": "vineyard.openWorkspace",
          "when": "false"
        },
        {
          "command": "vineyard.openTerminal",
          "when": "false"
        },
        {
          "command": "vineyard.copyPath",
          "when": "false"
        },
        {
          "command": "vineyard.removeMachine",
          "when": "false"
        },
        {
          "command": "vineyard.stopAgent",
          "when": "false"
        },
        {
          "command": "vineyard.takeOver",
          "when": "false"
        },
        {
          "command": "vineyard.resumeManaged",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Vineyard",
      "properties": {
        "vineyard.daemon.port": {
          "type": "number",
          "default": 7734,
          "description": "TCP port the daemon listens on (used when setting up new machines). All machines should use the same port."
        },
        "vineyard.transcriptLines": {
          "type": "number",
          "default": 400,
          "minimum": 20,
          "description": "How many trailing transcript lines to fetch when opening a transcript."
        },
        "vineyard.showHistoricalWorkspaces": {
          "type": "boolean",
          "default": true,
          "description": "Show workspaces that have Claude history but no live agent right now."
        },
        "vineyard.showExitedAgents": {
          "type": "boolean",
          "default": false,
          "description": "Show sessions whose process has exited but whose registry entry is still on disk."
        },
        "vineyard.showFinishedSubagents": {
          "type": "boolean",
          "default": true,
          "description": "Under each agent, show subagents and background tasks that have finished as well as those still running. Running ones are always shown."
        },
        "vineyard.notify.attention": {
          "type": "boolean",
          "default": true,
          "description": "Pop a notification when an agent starts waiting on you (question or permission). Sessions on this machine that Vineyard did not start (the Claude Code pane, a terminal) are skipped: they already prompt through their own UI. No notification is shown in a window where that agent's chat pane is the active tab; other windows and machines still get one."
        },
        "vineyard.notify.finished": {
          "type": "boolean",
          "default": false,
          "description": "Pop a notification when a working agent goes idle. Sessions on this machine that Vineyard did not start, and agents whose chat pane is the active tab, are skipped, as for vineyard.notify.attention."
        },
        "vineyard.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a fleet summary in the status bar."
        },
        "vineyard.ssh.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for the ssh/scp calls used to bootstrap machines."
        },
        "vineyard.spawn.defaultPermissionMode": {
          "type": "string",
          "enum": [
            "",
            "default",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "enumItemLabels": [
            "Claude Code's setting",
            "default",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "default": "",
          "markdownDescription": "Permission mode for a new agent in a workspace where none was chosen yet. A mode picked in an agent's chat is remembered for that workspace and wins over this (plan and bypass are not remembered). Left at *Claude Code's setting*, Vineyard passes no mode and Claude Code uses `permissions.defaultMode` from its settings files."
        },
        "vineyard.chat.observed": {
          "type": "string",
          "enum": [
            "observe",
            "takeOver"
          ],
          "enumDescriptions": [
            "Open the chat as an observer: messages go over Claude Code's cross-session socket; permission prompts and questions are answered in the pane or terminal where the session runs. Take Over Session is still there for when you want it.",
            "Take the session over when you open its chat: its process is ended and the session resumed as a child of that machine's daemon, so prompts, questions and permissions are answered from here. Idle sessions and ones waiting on a question are taken silently; a session mid-turn asks first, since the running tool's output is lost."
          ],
          "default": "observe",
          "description": "What opening the chat of a session Vineyard did not start does."
        },
        "vineyard.chat.openIn": {
          "type": "string",
          "enum": [
            "activeGroup",
            "beside"
          ],
          "enumDescriptions": [
            "Open the chat as a new tab in the editor group that has focus.",
            "Open the chat in a new editor group next to the one that has focus, splitting the pane."
          ],
          "default": "activeGroup",
          "description": "Where agent and workload chats open."
        },
        "vineyard.autoUpdateDaemons": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update the daemon on this machine to the version bundled with this extension. The binary travels over the local connection; the updated daemon then brings its peers up to its version over the mesh. Nothing happens unless a daemon is outdated while a Vineyard view is open."
        },
        "vineyard.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Once a day, ask GitHub Releases whether a newer Vineyard extension exists and offer to install it. This is the only time Vineyard talks to the internet."
        },
        "vineyard.sort.machines": {
          "type": "string",
          "enum": [
            "status",
            "name",
            "recent"
          ],
          "enumDescriptions": [
            "This machine, then online machines, then offline; alphabetical within each group.",
            "Alphabetical (this machine first).",
            "Most recently reported first (this machine first)."
          ],
          "default": "status",
          "description": "How machines are ordered in the Vineyard tree."
        },
        "vineyard.sort.workspaces": {
          "type": "string",
          "enum": [
            "name",
            "recent",
            "attention"
          ],
          "enumDescriptions": [
            "Alphabetical by folder name.",
            "Most recent activity first.",
            "Workspaces whose agents need you first, then by activity."
          ],
          "default": "name",
          "description": "How workspaces are ordered under each machine."
        },
        "vineyard.sort.agents": {
          "type": "string",
          "enum": [
            "recent",
            "name",
            "attention"
          ],
          "enumDescriptions": [
            "Newest session first (stable while agents work).",
            "Alphabetical by title.",
            "Agents that need you first, then newest."
          ],
          "default": "recent",
          "description": "How agents are ordered under each workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "build": "node esbuild.mjs",
    "build:daemon": "sh scripts/build-daemon.sh",
    "build:all": "npm run build:daemon && npm run build",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts' && cd daemon && go test ./...",
    "package": "vsce package --no-dependencies",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "marked": "^15.0.0"
  }
}
